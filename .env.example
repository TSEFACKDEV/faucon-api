# Copie ce fichier en `.env` et renseigne les valeurs.
# Ne jamais committer `.env` (secrets).

# HTTP / TCP
PORT=3000
TCP_PORT=5000
NODE_ENV=development

# Base de données PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/faucon_db

# Authentification JWT
JWT_ACCESS_SECRET=<secret-aléatoire-long>
JWT_REFRESH_SECRET=<secret-aléatoire-long>
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Clé API statique pour le provisioning en série (endpoint admin)
PROVISIONING_API_KEY=<clé-aléatoire>

# Clé partagée optionnelle pour /tracker/webhook et /tracker/sms (canaux de
# secours HTTP/SMS du firmware, non authentifiés tant que cette clé n'est pas
# définie ET que le firmware n'est pas mis à jour pour l'envoyer en paramètre
# `key` — coordonner avec le firmware avant d'activer. Laisser vide sinon.
TRACKER_WEBHOOK_KEY=

# SMTP (notifications / rapports)
MAIL_HOST=<hôte-smtp>
MAIL_PORT=587
MAIL_USER=<utilisateur>
MAIL_PASS=<mot-de-passe>

# Broker MQTT (réception des trames du firmware — canal « raw »).
# Host/port/user : voir les constantes MQTT_* du firmware (.ino).
# MQTT_BACKEND_PASSWORD doit correspondre au compte du backend sur le broker.
MQTT_BROKER_URL=mqtt://<hôte-broker>:1883
MQTT_BACKEND_USERNAME=<utilisateur-backend>
MQTT_BACKEND_PASSWORD=<mot-de-passe-broker>

# Clé HMAC-SHA256 partagée avec le firmware pour signer les commandes
# descendantes et les ACK. Doit être identique à CMD_SIGN_KEY dans le .ino.
# Générer avec : openssl rand -hex 32
COMMAND_SIGNING_KEY=<clé-aléatoire-64-chars>

# ─── SÉCURITÉ RÉSEAU ──────────────────────────────────────────────
# TLS : le broker MQTT devrait tourner en TLS (port 8883) en production.
# Côté firmware (A9G), utiliser AT+MQTTCONN avec le port 8883 et le
# certificat CA racine. Le broker doit présenter un certificat signé
# (Let's Encrypt, etc.).
#
# Le serveur TCP (port 5000) et le webhook HTTP sont des canaux de
# SECOURS non chiffrés. En production, les placer derrière un reverse
# proxy TLS (nginx, Caddy) ou un VPN.
# MQTT_BROKER_URL=mqtt://<hôte>:1883 → mqtt://<hôte>:8883 en TLS
