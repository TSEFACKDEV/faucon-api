# Copie ce fichier en `.env` et renseigne les valeurs.
# Ne jamais committer `.env` (secrets).

# HTTP / TCP
PORT=3000
TCP_PORT=5000
NODE_ENV=development

# Base de données PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/faucon_db

# Authentification JWT
JWT_ACCESS_SECRET=<secret-aléatoire-long>
JWT_REFRESH_SECRET=<secret-aléatoire-long>
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Clé API statique pour le provisioning en série (endpoint admin)
PROVISIONING_API_KEY=<clé-aléatoire>

# SMTP (notifications / rapports)
MAIL_HOST=<hôte-smtp>
MAIL_PORT=587
MAIL_USER=<utilisateur>
MAIL_PASS=<mot-de-passe>
