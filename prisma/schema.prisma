// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  UTILISATEUR
  ADMIN
}

enum ModeFonctionnement {
  WORK
  MOVE
  STANDBY
}

enum TypeAlarme {
  SORTIE_ZONE
  VITESSE_EXCESSIVE
  DECOLLEMENT_TRACEUR
  NON_MOUVEMENT
  BATTERIE_FAIBLE
}

enum StatutCommande {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
}

model Utilisateur {
  id             String    @id @default(uuid())
  userName       String    @unique
  email          String    @unique
  motDePasseHash String
  telephone      String?
  role           Role      @default(UTILISATEUR)
  dateCreation   DateTime  @default(now())
  derniereConnexion DateTime?

  vehicules      Vehicule[]
  refreshTokens  RefreshToken[]

  @@map("utilisateurs")
}

model RefreshToken {
  id              String      @id @default(uuid())
  token           String      @unique
  utilisateurId   String
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  dateExpiration  DateTime
  dateCreation    DateTime    @default(now())

  @@map("refresh_tokens")
}

model Vehicule {
  id                    String             @id @default(uuid())
  imei                  String?            @unique
  trackerId             String?            @unique
  pinActivation         String?
  nom                   String
  image                 String?
  // Numéro qui reçoit les SMS d'alerte envoyés DIRECTEMENT par le traceur
  // (indépendant du réseau/backend) — configurable depuis l'app, poussé au
  // traceur via la commande descendante NUMERO_SMS (cf. vehicle.service.ts).
  telephoneAlerte       String?
  // Identifiants MQTT uniques par traceur (générés au provisionnement).
  // Le firmware les lit depuis les Preferences ESP32 au démarrage et les
  // utilise pour se connecter au broker. Remplace les credentials partagés
  // (faucon_tracker/faucon) pour l'isolation : un traceur compromis ne peut
  // plus publier/s'abonner aux topics d'un autre traceur.
  mqttUser              String?
  mqttPassword          String?
  modeActuel            ModeFonctionnement @default(MOVE)
  niveauBatterie        Int                @default(100)
  estActif              Boolean            @default(true)
  dateAjout             DateTime           @default(now())
  derniereCommunication DateTime?

  utilisateurId         String?
  utilisateur           Utilisateur?       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  limiteVitesse         LimiteVitesse?
  perimetreGeofence     PerimetreGeofence?
  positions             Position[]
  alarmes               Alarme[]
  rapportsJournaliers   RapportJournalier[]
  commandes             CommandeDescendante[]
  diagnostics           DiagnosticTraceur[]

  @@index([utilisateurId])
  @@map("vehicules")
}

// Diagnostic périodique publié par le firmware sur faucon/<trackerId>/diag
// (toutes les 5 minutes, cf. publierDiag dans faucon_v12.ino). C'est la
// seule source permettant de connaître l'état réel du boîtier : mode
// appliqué, version du firmware, compteurs de reset, santé I2C, file
// d'attente du journal flash, mémoire libre...
model DiagnosticTraceur {
  id            String   @id @default(uuid())
  vehiculeId    String
  vehicule      Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  horodatage    DateTime @default(now())

  // Identité matérielle et logicielle du boîtier.
  modele        String?
  version       String?
  // Mode RÉELLEMENT appliqué (WORK / MOVE / STANDBY) — la valeur de
  // référence, contrairement au modeActuel du véhicule qui peut être
  // optimiste (commande envoyée mais pas encore acquittée).
  mode          String?

  // Diagnostic de redémarrage.
  causeReset    String?
  resetCode     Int?
  dernierArret  String?
  nbWatchdog    Int      @default(0)
  nbBrownout    Int      @default(0)
  nbPanique     Int      @default(0)

  // GPS.
  fixValide     Boolean  @default(false)
  fixPerime     Boolean  @default(false)
  ageFixSecondes Int?
  satellites    Int?
  hdop          Float?

  // Énergie et réseau.
  batteriePct   Int?
  signalPct     Int?
  signalValide  Boolean  @default(false)

  // Santé du Traceur.
  i2cRecuperations Int   @default(0)
  i2cSuspendu   Boolean  @default(false)
  journalOk     Boolean  @default(false)
  positionsPerdues Int   @default(0)
  fileNombre    Int?
  sourceHeure   String?
  heapLibre     Int?

  // Payload diag complet, pour tracer les évolutions d'un champ absent
  // du modèle (diagnostic complet et faithful du firmware).
  brut          Json?

  @@index([vehiculeId, horodatage])
  @@map("diagnostics_traceurs")
}

model Position {
  id             BigInt    @id @default(autoincrement())
  vehiculeId     String
  vehicule       Vehicule  @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  altitude       Float?
  vitesse        Float
  cap            Float?
  nbSatellites   Int?
  niveauSignal   Int?
  hdop           Float?
  niveauBatterie Int
  statutACC      Boolean
  cyc            Int?
  alr            Int?
  horodatage     DateTime
  dateReception  DateTime  @default(now())

  @@index([vehiculeId, horodatage])
  @@map("positions")
}

model LimiteVitesse {
  id         String   @id @default(uuid())
  vehiculeId String   @unique
  vehicule   Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  seuilKmh   Float
  estActive  Boolean  @default(true)
  dateModif  DateTime @updatedAt

  @@map("limites_vitesse")
}

model PerimetreGeofence {
  id          String   @id @default(uuid())
  vehiculeId  String   @unique
  vehicule    Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  nom         String
  centreLat   Float
  centreLon   Float
  rayonMetres Float
  estActif    Boolean  @default(true)
  dateModif   DateTime @updatedAt

  @@map("perimetres_geofence")
}

model Alarme {
  id               String     @id @default(uuid())
  vehiculeId       String
  vehicule         Vehicule   @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  typeAlarme       TypeAlarme
  latitude         Float
  longitude        Float
  valeurMesuree    Float?
  seuilConfigure   Float?
  estAcquittee     Boolean    @default(false)
  dateAcquittement DateTime?
  horodatage       DateTime
  dateCreation     DateTime   @default(now())

  @@index([vehiculeId, horodatage])
  @@index([estAcquittee])
  @@map("alarmes")
}

model RapportJournalier {
  id                String   @id @default(uuid())
  vehiculeId        String
  vehicule          Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  distanceTotaleKm  Float    @default(0)
  vitesseMoyenne    Float    @default(0)
  vitesseMax        Float    @default(0)
  nbAlarmes         Int      @default(0)
  tempsArretMinutes Int      @default(0)
  dateGeneration    DateTime @default(now())

  @@unique([vehiculeId, date])
  @@map("rapports_journaliers")
}

model CommandeDescendante {
  id              String         @id @default(uuid())
  vehiculeId      String
  vehicule        Vehicule       @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)
  codeCommande    String
  parametres      Json?
  statutExecution StatutCommande @default(PENDING)
  dateEnvoi       DateTime       @default(now())
  dateReponse     DateTime?

  // vehiculeId : utilisé par vehicleService.getCommandes (liste par véhicule).
  // (statutExecution, dateEnvoi) : scanné CHAQUE MINUTE par le cron de
  // nettoyage des commandes expirées (scheduler.ts) — sans index, full table
  // scan récurrent qui se dégrade avec le volume.
  @@index([vehiculeId])
  @@index([statutExecution, dateEnvoi])
  @@map("commandes_descendantes")
}